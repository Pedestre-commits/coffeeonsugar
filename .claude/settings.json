{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "WebFetch(domain:www.cardmarket.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull origin dev 2>/dev/null; true",
            "statusMessage": "Syncing latest changes..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git add -A 2>/dev/null; git diff --cached --quiet || git commit -m \"auto: session sync $(date +%Y-%m-%d)\"; git push origin dev 2>/dev/null; true",
            "statusMessage": "Pushing session changes...",
            "async": true
          }
        ]
      }
    ]
  }
}
